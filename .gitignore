# =============================================================================
# .gitignore — Storico: Invoice Payment Pattern Learning System
# =============================================================================
# Only source code, tests, and documentation are tracked.
# Datasets, ML artefacts, generated output, and secrets remain local.
# =============================================================================


# ── [1] SOURCE DATA & INPUTS ─────────────────────────────────────────────────
# Do not commit real accounting data or large source files.
data/raw/*.xlsx
data/raw/*.csv
data/raw/*.xls
data/raw/*.xlsm
data/normalized/*.parquet
data/curated/*.parquet
data/curated/*.csv
data/mock/*.parquet
data/mock/*.csv
data/*.xlsx
data/*.xls
data/*.csv
# Keep the minimal CI sample
!data/raw_sample/
!data/raw_sample/**


# ── [2] ML MODELS & TRAINING ARTEFACTS ───────────────────────────────────────
# Weights and serialised models are too large for git; use DVC or local storage.
models/
catboost_info/
autogluon_models/
**/*.cbm
**/*.pkl
**/*.joblib
**/*.bin
**/*.onnx
**/*.pt
**/*.pth
**/*.h5
**/*.hdf5
**/*.safetensors
**/*.gguf
**/*.ggml


# ── [3] GENERATED REPORTS & OUTPUT ───────────────────────────────────────────
reports/
**/*.html
**/*.pdf
!docs/*.png
!docs/*.svg


# ── [4] RUNTIME LOGS ─────────────────────────────────────────────────────────
logs/
**/*.jsonl
*.log


# ── [5] SECRETS & ENVIRONMENT CONFIGURATION ──────────────────────────────────
.env
.env.*
!.env.example
*.env
secrets.yaml
secrets.json
secrets.toml
credentials.json
credentials.yaml
config.local.py
**/config/local_*.py
**/*_secret*
**/*_private*


# ── [6] PYTHON BYTECODE & VIRTUAL ENVIRONMENTS ───────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
*.whl
pip-wheel-metadata/


# ── [7] CONDA / PIPENV / POETRY LOCKS ────────────────────────────────────────
.conda/
Pipfile.lock
poetry.lock


# ── [8] JUPYTER ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/


# ── [9] IDE & EDITOR ──────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~


# ── [10] TESTING & COVERAGE ──────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover
.hypothesis/


# ── [11] OS FILES ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
$RECYCLE.BIN/
desktop.ini


# ── [12] TEMPORARY & BUILD FILES ─────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
tmp/
temp/
.cache/
